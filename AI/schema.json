{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldTradingSystem AI Analysis",
  "type": "object",
  "required": ["market_regime","bias","confidence","key_support","key_resistance","long_zones","short_zones","entry_plan_long","entry_plan_short","invalidation","orderflow_assessment","position_management","no_trade_conditions","validity","reasoning_summary"],
  "properties": {
    "market_regime": {"enum": ["EXTREME_TREND","TREND","RANGE","TRANSITION"]},
    "bias": {"enum": ["LONG","SHORT","NEUTRAL"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "key_support": {"type": "array"},
    "key_resistance": {"type": "array"},
    "long_zones": {"type": "array"},
    "short_zones": {"type": "array"},
    "entry_plan_long": {"type": "object"},
    "entry_plan_short": {"type": "object"},
    "invalidation": {"type": ["object","array","string"]},
    "orderflow_assessment": {"type": ["object","string"]},
    "position_management": {"type": ["object","array","string"]},
    "no_trade_conditions": {"type": "array"},
    "validity": {"type": ["object","string"]},
    "reasoning_summary": {"type": "string"}
  },
  "additionalProperties": true
}
